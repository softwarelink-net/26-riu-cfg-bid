{
  "name": "26-riu-cfg-bid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "开放式架构的远程接口单元接口配置工具招标数字化全案系统",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.ts --max-warnings 0",
    "db:seed": "wrangler d1 migrations apply Allworld --local",
    "db:migrate:remote": "wrangler d1 migrations apply Allworld --remote",
    "deploy": "npm run build && wrangler deploy",
    "sitemap:upload": "node scripts/upload-sitemap-r2.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "pinia-plugin-persistedstate": "^3.2.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-eslint-parser": "^9.4.3",
    "wrangler": "^3.99.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
